{
  "manifest_version": 3,
  "name": "NeuralMeter Bridge",
  "version": "0.1.0",
  "description": "Leitura passiva de uso de claude.ai e chatgpt.com para o NeuralMeter (local).",
  "minimum_chrome_version": "116",
  "permissions": ["alarms"],
  "host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/page_hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/sse.js", "src/context_tracker.js", "src/claude_capture.js"],
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*"]
    }
  ]
}
